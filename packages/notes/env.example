# ─── Authentication (choose one method) ─────────────────────────

# Option 1: Username/Password (recommended — easiest to set up)
# dotenv treats # as the start of a comment in unquoted values.
# Quote secrets that contain #, for example: SAP_PASSWORD="My#Pass"
SAP_USERNAME=your.email@company.com
SAP_PASSWORD="your_sap_password"

# Option 2: SAP Passport Certificate
# PFX_PATH=./certs/sap.pfx
# PFX_PASSPHRASE="your_certificate_passphrase_here"

# Auth method selection: 'auto' (default), 'password', or 'certificate'
# auto = tries password first if credentials are set, then certificate
AUTH_METHOD=auto

# Shared Playwright storage state for SAP SSO (recommended when using multiple SAP MCPs)
# Run once with HEADFUL=true and complete SAP login manually to populate it.
SAP_SSO_STORAGE_STATE=~/.sap-mcp/sso-storage-state.json
SAP_LOGIN_URL=https://me.sap.com/home

# Optional token cache path
# SAP_NOTES_TOKEN_CACHE_FILE=./token-cache.json

# ─── MFA / 2FA ──────────────────────────────────────────────────

# Timeout for manual 2FA code entry (ms). Set HEADFUL=true to see the prompt.
MFA_TIMEOUT=120000

# ─── General ────────────────────────────────────────────────────

# Token cache lifetime in hours (default: 12)
MAX_JWT_AGE_H=12

# Show browser window during authentication (required for manual 2FA)
HEADFUL=false

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ─── SAP Note S3 Cache (optional) ──────────────────────────────

# Bucket to cache fetched SAP Note details in (keyed by note ID, no expiry).
# Skips SAP's fallback fetch chain on repeat lookups of the same note.
# Leave unset to disable caching entirely. Requires AWS credentials via the
# default provider chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_REGION, or AWS_PROFILE for a named SSO/IAM-role profile) and a bucket
# that already exists. Note: the JS SDK reads AWS_REGION, not
# AWS_DEFAULT_REGION (that's a CLI/other-SDK-only convention).
# SAP_NOTES_CACHE_BUCKET=your-sap-notes-cache-bucket
# AWS_REGION=us-east-1
# AWS_PROFILE=your-sso-profile-name

# ─── HTTP MCP Server (optional) ────────────────────────────────

# Port for the HTTP MCP transport (default: 3123)
HTTP_PORT=3123

# Bearer token to protect the HTTP endpoint.
# If set, clients must send 'Authorization: Bearer <token>'.
# Leave empty to disable (not recommended for production).
ACCESS_TOKEN=

{
  "name": "sap-note-search-mcp",
  "version": "0.3.3",
  "description": "MCP server for searching SAP Notes/KB articles using SAP Passport authentication and Playwright automation",
  "main": "dist/mcp-server.js",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "env.example",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/mcp-server.ts",
    "dev:http": "tsx watch src/http-mcp-server.ts",
    "serve": "node dist/mcp-server.js",
    "serve:http": "AUTO_START=true node dist/http-mcp-server.js",
    "serve:http:debug": "LOG_LEVEL=debug HTTP_PORT=3123 AUTO_START=true DEBUG_START=true node dist/http-mcp-server.js",
    "start": "npm run build && npm run serve",
    "start:http": "npm run build && npm run serve:http",
    "start:http:debug": "npm run build && npm run serve:http:debug",
    "test:auth": "npm run build && node test/test-auth.js",
    "test:auth:debug": "npm run build && HEADFUL=true LOG_LEVEL=debug node test/test-auth.js",
    "test:docker:debug": "npm run build && node test/test-docker-debug.js",
    "test:mcp": "npm run build && node test/test-mcp-server.js",
    "test:mcp:debug": "npm run build && LOG_LEVEL=debug DOCKER_ENV=true node test/test-mcp-server.js",
    "test:api": "npm run build && node test/test-sap-api.js",
    "test:flow": "npm run build && node test/test-full-flow.js",
    "test": "npm run test:auth && npm run test:api && npm run test:mcp",
    "debug:container": "./debug-container.sh",
    "clean": "rimraf dist"
  },
  "keywords": [
    "sap",
    "notes",
    "mcp",
    "model-context-protocol",
    "playwright",
    "search",
    "knowledge-base"
  ],
  "author": "marianfoo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianfoo/sap-mcp-servers.git",
    "directory": "packages/notes"
  },
  "homepage": "https://github.com/marianfoo/sap-mcp-servers/tree/main/packages/notes#readme",
  "bugs": {
    "url": "https://github.com/marianfoo/sap-mcp-servers/issues"
  },
  "dependencies": {
    "@marianfoo/sap-mcp-auth": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.58.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "rimraf": "^6.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
